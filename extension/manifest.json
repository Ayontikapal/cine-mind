{
  "manifest_version": 3,
  "name": "CineMind - Smart Movie Signal Sync",
  "version": "1.0.0",
  "description": "Authorized browser signal connector for CineMind movie recommendations. Learns movie tastes from authorized browsing.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.imdb.com/title/*",
        "https://letterboxd.com/film/*",
        "https://www.rottentomatoes.com/m/*",
        "https://www.youtube.com/watch*"
      ],
      "js": ["content/content.js"]
    }
  ]
}
