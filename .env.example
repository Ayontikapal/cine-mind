# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# TMDB API Key (Movie Metadata & Streaming Providers)
TMDB_API_KEY=your-tmdb-api-key

# Gemini AI Key (for taste profiles & recommendations)
GEMINI_API_KEY=your-gemini-api-key

# LLM Model Name (default: gemini-1.5-flash or gemini-2.0-flash)
LLM_MODEL=gemini-2.0-flash

# Optional Watch Provider API Key (TMDB includes Watch Providers with TMDB_API_KEY)
WATCH_PROVIDER_API_KEY=

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
